          },
          "category": {
            "type": "string"
          },
          "price_cents": {
            "type": "integer"
          },
          "qty_in_stock": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
