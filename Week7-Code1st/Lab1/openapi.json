          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ProductIn": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "pattern": "^[A-Z0-9-]{3,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "default": null,
            "maxLength": 1000,
            "nullable": true
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0
          },
          "qty_in_stock": {
            "type": "integer",
            "default": 0,
            "minimum": 0
          }
        },
        "required": [
          "category",
          "name",
          "price_cents",
          "sku"
        ],
        "additionalProperties": false
      },
      "ProductPatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "nullable": true
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0
          },
          "qty_in_stock": {
            "type": "integer",
            "minimum": 0
          },
          "archived": {
            "type": "boolean"
          }
